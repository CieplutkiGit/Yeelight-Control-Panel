QWidget {
    color: #172033;
    background: #f5f7fb;
}
QMainWindow, QMenuBar, QMenu, QDialog {
    background: #ffffff;
}
QPushButton, QLineEdit, QSpinBox, QComboBox {
    min-height: 36px;
    border: 1px solid #c9d1df;
    border-radius: 8px;
    padding: 0 10px;
    background: #ffffff;
}
QPushButton:hover { background: #eef3ff; }
QPushButton:disabled { color: #8b94a5; background: #edf0f5; }
QPushButton:focus, QLineEdit:focus, QListView:focus, QTabBar::tab:focus {
    border: 2px solid #3268d8;
}
QListView { border: 0; background: transparent; }
QListView::item { min-height: 56px; padding: 8px; border-radius: 8px; }
QListView::item:selected { background: #dce8ff; color: #102a56; }
QTabWidget::pane { border: 0; }
QTabBar::tab { min-height: 36px; padding: 0 12px; }
#applicationTitle { font-size: 22px; font-weight: 600; }
#localOnlyBadge, #connectionBadge {
    padding: 4px 8px;
    border-radius: 8px;
    background: #e4f5eb;
    color: #17653a;
}
#connectionBadge[online="false"] {
    background: #eceff4;
    color: #5f6878;
}
#emptyStateTitle, #selectedDeviceName { font-size: 20px; font-weight: 600; }
#validationErrorLabel { color: #a31d2d; }
