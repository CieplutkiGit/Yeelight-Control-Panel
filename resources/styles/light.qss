QMainWindow {
    color: #172033;
    background: #eef2f8;
}
QMenuBar, QMenu, QDialog {
    color: #172033;
    background: #ffffff;
}
QWidget#mainWindowSurface {
    background: #eef2f8;
}
QFrame#sidebar {
    background: #f8faff;
    border: 1px solid #dce3ee;
    border-radius: 16px;
}
QFrame#contentArea {
    background: #f3f6fa;
    border: 1px solid #dfe6f0;
    border-radius: 16px;
}
QFrame#card {
    background: #ffffff;
    border: 1px solid #dce3ee;
    border-radius: 14px;
}
QLabel#cardTitle {
    color: #172033;
    font-size: 13px;
    font-weight: 600;
}
QLabel#applicationTitle {
    color: #172033;
    font-size: 22px;
    font-weight: 600;
}
QLabel#sectionLabel {
    color: #718098;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
}
QLabel#selectedDeviceName, QLabel#emptyStateTitle {
    color: #172033;
    font-size: 20px;
    font-weight: 600;
}
QLabel#selectedDeviceDetails, QLabel#lastSeenLabel, QLabel#connectionStatusLabel {
    color: #718098;
}
QLabel#localOnlyBadge, QLabel#connectionBadge {
    padding: 5px 8px;
    border-radius: 8px;
    background: #e3f5ea;
    color: #17653a;
}
QLabel#connectionBadge[online="false"] {
    background: #edf0f5;
    color: #667184;
}
QPushButton, QLineEdit, QSpinBox, QComboBox {
    min-height: 34px;
    color: #172033;
    border: 1px solid #c9d3e1;
    border-radius: 8px;
    padding: 0 10px;
    background: #ffffff;
}
QPushButton:hover, QComboBox:hover, QLineEdit:hover, QSpinBox:hover {
    background: #f1f5fc;
    border-color: #9fb4d6;
}
QPushButton:pressed {
    background: #e5edfc;
}
QPushButton:disabled, QSlider:disabled {
    color: #99a4b5;
}
QPushButton:focus, QLineEdit:focus, QListView:focus, QComboBox:focus,
QSpinBox:focus {
    border: 1px solid #3268d8;
}
QPushButton#navigationButton {
    min-height: 38px;
    text-align: left;
    border: 1px solid transparent;
    background: transparent;
    color: #6d7890;
}
QPushButton#navigationButton:hover {
    color: #172033;
    background: #edf2fb;
}
QPushButton#navigationButton:checked {
    color: #102a56;
    background: #dce8ff;
    border-color: #b3c9f4;
}
QPushButton#powerToggle {
    min-width: 104px;
    background: #f0f3f8;
    border-color: #c9d3e1;
}
QPushButton#powerToggle:checked {
    background: #e1f4e9;
    border-color: #8bc9a6;
    color: #17653a;
}
QListView {
    border: 0;
    background: transparent;
}
QListView::item {
    min-height: 56px;
    padding: 8px;
    border-radius: 8px;
}
QListView::item:selected {
    background: #dce8ff;
    color: #102a56;
}
QSlider::groove:horizontal {
    height: 5px;
    border-radius: 2px;
    background: #d5dce7;
}
QSlider::handle:horizontal {
    width: 16px;
    margin: -6px 0;
    border-radius: 8px;
    background: #3268d8;
    border: 2px solid #d5e2ff;
}
QSlider::sub-page:horizontal {
    border-radius: 2px;
    background: #3268d8;
}
QSlider#dashboardTemperatureSlider::groove:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #e87943, stop:0.5 #f2c84b, stop:1 #8eb3f3);
}
QSlider#dashboardTemperatureSlider::sub-page:horizontal {
    background: transparent;
}
QComboBox::drop-down {
    border: 0;
    width: 24px;
}
QComboBox QAbstractItemView {
    color: #172033;
    background: #ffffff;
    selection-background-color: #dce8ff;
}
QAbstractItemView, QTableView, QListWidget, QPlainTextEdit {
    background: #ffffff;
    border: 1px solid #dce3ee;
}
#validationErrorLabel { color: #a31d2d; }
